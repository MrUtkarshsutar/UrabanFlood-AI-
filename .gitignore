# ==============================================================================
# UrbanFlood AI - Root .gitignore
# Covers Python, Node.js/React, GIS/Spatial Data, AI Models, Databases, and Secrets
# ==============================================================================

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
credentials.json
service-account.json

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Jupyter Notebooks ---
.ipynb_checkpoints
*-checkpoint.ipynb
ai/notebooks/.ipynb_checkpoints/

# --- Node.js & Frontend (Vite / React) ---
frontend/node_modules/
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Database & Local Storage ---
*.sqlite
*.sqlite3
*.db
postgres_data/
postgis_data/
*.sql.gz

# --- GIS / Geospatial Datasets (Large binary rasters & vector caches) ---
# Raw satellite/DEM rasters & intermediate shapefiles should not be committed to Git
gis/raster/*.tif
gis/raster/*.tiff
gis/raster/*.dem
gis/raster/*.nc
gis/shapefiles/*.shp
gis/shapefiles/*.shx
gis/shapefiles/*.dbf
gis/shapefiles/*.prj
gis/shapefiles/*.cpg
gis/geojson/*.geojson
!gis/geojson/.gitkeep
!gis/raster/.gitkeep
!gis/shapefiles/.gitkeep
*.qgs~
*.qgz~

# --- AI/ML Model Artifacts & Large Datasets ---
ai/data/raw/*
ai/data/processed/*
ai/data/external/*
!ai/data/raw/.gitkeep
!ai/data/processed/.gitkeep
!ai/data/external/.gitkeep
ai/models/saved/*.joblib
ai/models/saved/*.pkl
ai/models/saved/*.onnx
ai/models/saved/*.h5
ai/models/saved/*.pt
ai/models/saved/*.pth
!ai/models/saved/.gitkeep

# --- Simulation & Routing Artifacts ---
simulation/scenarios/*.parquet
simulation/scenarios/*.csv
routing/graph/*.graphml
routing/graph/*.pkl
!routing/graph/.gitkeep
!simulation/scenarios/.gitkeep

# --- Logs & Runtime Output ---
logs/
*.log
*.pid
