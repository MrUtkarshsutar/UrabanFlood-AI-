# UrbanFlood AI Frontend Environment Variables

# Backend API Base URL (FastAPI)
VITE_API_BASE_URL=http://localhost:8000

# Demo & Simulation Mode (true = use realistic client-side simulation & mock layer; false = call live backend)
VITE_DEMO_MODE=true

# Geospatial Default Centroid (Pune Metropolitan / Mula-Mutha Basin)
VITE_MAP_DEFAULT_LAT=18.5204
VITE_MAP_DEFAULT_LNG=73.8567
VITE_MAP_DEFAULT_ZOOM=13

# Optional OpenWeather / Radar Map Tile Overlays
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
