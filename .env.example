# ==============================================================================
# UrbanFlood AI - Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholder values with your own credentials.
# NEVER commit the active .env file containing secrets to version control.
# ==============================================================================

# --- System & Deployment Environment ---
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="UrbanFlood AI"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-secure-random-32-character-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS & Networking ---
# Comma-separated list of allowed origins for frontend communication
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://urbanflood-ai.vercel.app"

# --- Frontend Application (Vite / React) ---
# Note: Vite client-side variables must be prefixed with VITE_
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_DEFAULT_CITY="Metropolis"
VITE_DEFAULT_LAT=19.0760
VITE_DEFAULT_LNG=72.8777
VITE_DEFAULT_ZOOM=12
VITE_ENABLE_OFFLINE_CACHE=true

# --- Database & Storage Configuration ---
# Production / Local PostGIS connection string:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/urbanflood_db"
# Fallback local SQLite string (uncomment if testing without PostgreSQL):
# DATABASE_URL="sqlite+aiosqlite:///./urbanflood.db"
POSTGIS_ENABLED=false
DB_ECHO=false

# --- External Weather & Geospatial Data Services (Free-Tier / Open) ---
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"
OPEN_METEO_ARCHIVE_URL="https://archive-api.open-meteo.com/v1/archive"
OSM_OVERPASS_URL="https://overpass-api.de/api/interpreter"
OSRM_ROUTING_URL="https://router.project-osrm.org"
COPERNICUS_DEM_BASE_URL="https://copernicus-dem-30m.s3.amazonaws.com"

# --- Data Pipeline & Scheduler Settings ---
WEATHER_FETCH_INTERVAL_MINUTES=15
RISK_REEVALUATION_INTERVAL_MINUTES=30
DRAINAGE_CAPACITY_FACTOR=0.75

# --- AI/ML Model Settings ---
MODEL_PATH="ai/models/saved/xgboost_flood_model_latest.joblib"
SCALER_PATH="ai/models/saved/feature_scaler_latest.joblib"
MODEL_VERSION="v1.0.0"

# Calibrated Risk Thresholds [0.0 to 1.0 probability]
RISK_THRESHOLD_MODERATE=0.30
RISK_THRESHOLD_HIGH=0.60
RISK_THRESHOLD_CRITICAL=0.85

# --- Emergency Alerts & Notification Gateway (Optional / Planned) ---
ALERT_EXPIRY_HOURS=6
NOTIFICATIONS_ENABLED=false
SMS_GATEWAY_PROVIDER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SENDER_NUMBER=""
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""

# --- Routing Engine Constraints ---
MAX_FLOOD_RISK_FOR_PASSABLE_ROUTE=0.55
ELEVATION_WEIGHT_FACTOR=1.4
WATER_LOGGING_PENALTY_FACTOR=3.0
